import React, { createContext, useContext, useEffect, useState } from 'react';
import { supabase } from './supabase';

interface UserContextType {
  accountType: 'buyer' | 'seller' | null;
  userId: string | null;
  setAccountType: (type: 'buyer' | 'seller' | null) => void;
}

const UserContext = createContext<UserContextType>({
  accountType: null,
  userId: null,
  setAccountType: () => {},
});

export const UserProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [accountType, setAccountType] = useState<'buyer' | 'seller' | null>(null);
  const [userId, setUserId] = useState<string | null>(null);

  useEffect(() => {
    const setupUserListener = async () => {
      const { data: { user } } = await supabase.auth.getUser();
      
      if (user) {
        setUserId(user.id);
        
        // Fetch account type
        const { data, error } = await supabase
          .from('users')
          .select('account_type')
          .eq('id', user.id)
          .maybeSingle();

        if (!error && data) {
          setAccountType(data.account_type as 'buyer' | 'seller');
          console.log('👤 [UserContext] Account type set to:', data.account_type);
        }
      }
    };

    setupUserListener();

    // Listen for auth changes
    const { data: { subscription } } = supabase.auth.onAuthStateChange(async (event, session) => {
      if (session?.user) {
        setUserId(session.user.id);
        const { data } = await supabase
          .from('users')
          .select('account_type')
          .eq('id', session.user.id)
          .maybeSingle();
        
        if (data) {
          setAccountType(data.account_type as 'buyer' | 'seller');
        }
      } else {
        setUserId(null);
        setAccountType(null);
      }
    });

    return () => subscription?.unsubscribe();
  }, []);

  return (
    <UserContext.Provider value={{ accountType, userId, setAccountType }}>
      {children}
    </UserContext.Provider>
  );
};

export const useUser = () => {
  const context = useContext(UserContext);
  if (!context) {
    throw new Error('useUser must be used within UserProvider');
  }
  return context;
};