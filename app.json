{
  "expo": {
    "name": "Automobile",
    "slug": "Automobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LOGOO.png",
    "scheme": "automobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/auto.png",
      "resizeMode": "cover",
      "backgroundColor": "#05696F"
    },
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:hhzwamxtmjdxtdmiwshi.supabase.co"
      ],
      "bundleIdentifier": "com.amina75.automobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05696F",
        "foregroundImage": "./assets/images/LOGOO.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.amina75.automobile",
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hhzwamxtmjdxtdmiwshi.supabase.co",
              "pathPrefix": "/auth/v1/verify"
            },
            {
              "scheme": "automobile"
            }
          ],
          "category": [
            "android.intent.category.BROWSABLE",
            "android.intent.category.DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://hhzwamxtmjdxtdmiwshi.supabase.co"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/auto.png",
          "resizeMode": "cover",
          "backgroundColor": "#1085a8ff"
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "677bf1a3-4eec-4a8c-83b3-eef0f06fc214"
      }
    }
  }
}